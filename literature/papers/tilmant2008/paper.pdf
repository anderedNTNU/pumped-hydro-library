         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Policy Sciences: System operation and management; Policy Sciences: Decision making under uncertainty; Hydrology: Reservoirs (surface); Hydrology: Water management</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Assessing marginal water values in multipurpose multireservoir systems via stochastic programming</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>A. Tilmant, D. Pinte, Q. Goor</rdf:li>
